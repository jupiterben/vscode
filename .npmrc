disturl="https://electronjs.org/headers"
target="39.8.0"
ms_build_id="13470701"
runtime="electron"
ignore-scripts=false
build_from_source="true"
legacy-peer-deps="true"
timeout=180000

# Windows MSB8040 fix: disable Spectre mitigation for native addon builds (optional; if install still fails, install Spectre libs from VS Installer)
msbuild_args=/p:SpectreMitigation=false
